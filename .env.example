# Copy to .env and fill in only what you have. The app runs without these.
# Hooks, offers, titles, and the script use a local template until one LLM key is set.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Word-level captions once you upload footage.
DEEPGRAM_API_KEY=

# Optional. Leave blank and drop two music files in the footage step instead.
EPIDEMIC_API_KEY=

# Durable projects and footage. Both are required. The service role stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required on a public URL. The browser sends it as a bearer token and a cookie.
DESK_TOKEN=
